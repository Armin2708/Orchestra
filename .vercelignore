# Vercel builds only the cloud workspace bundle: `npm ci --prefix web` then
# `npm run build:cloud --prefix web` (see vercel.json). Nothing outside web/ is
# needed, and the local code-intelligence and knowledge-graph caches are large
# enough to blow the 100 MB per-file upload limit — .gitnexus/lbug alone is 210 MB.
.gitnexus
graphify-out
site
dist
.remember
.superpowers
.claude
.worktrees
