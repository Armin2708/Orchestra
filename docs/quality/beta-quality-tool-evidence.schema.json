{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "tool", "slice_id", "tested_commit", "base_ref", "range",
        "tool_version", "requests", "unresolved_findings"
      ],
      "properties": {
        "schema_version": { "const": 3 },
        "tool": { "const": "gitnexus" },
        "slice_id": { "$ref": "#/$defs/slice" },
        "tested_commit": { "$ref": "#/$defs/commit" },
        "base_ref": { "$ref": "#/$defs/commit" },
        "range": { "$ref": "#/$defs/range" },
        "tool_version": { "type": "string", "minLength": 1 },
        "requests": {
          "type": "object", "additionalProperties": false,
          "required": ["impact", "detect_changes"],
          "properties": {
            "impact": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "$ref": "#/$defs/impactRequest" }
            },
            "detect_changes": { "$ref": "#/$defs/detectRequest" }
          }
        },
        "unresolved_findings": { "$ref": "#/$defs/findings" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "tool", "slice_id", "tested_commit", "base_ref", "range",
        "tool_version", "requests", "artifacts", "unresolved_findings"
      ],
      "properties": {
        "schema_version": { "const": 3 },
        "tool": { "const": "graphify" },
        "slice_id": { "$ref": "#/$defs/slice" },
        "tested_commit": { "$ref": "#/$defs/commit" },
        "base_ref": { "$ref": "#/$defs/commit" },
        "range": { "$ref": "#/$defs/range" },
        "tool_version": { "type": "string", "minLength": 1 },
        "requests": {
          "type": "object", "additionalProperties": false,
          "required": ["update", "status"],
          "properties": {
            "update": { "$ref": "#/$defs/graphifyRequest" },
            "status": { "$ref": "#/$defs/graphifyRequest" }
          }
        },
        "artifacts": {
          "type": "object", "additionalProperties": false,
          "required": ["graph", "manifest"],
          "properties": {
            "graph": { "$ref": "#/$defs/artifact" },
            "manifest": { "$ref": "#/$defs/artifact" }
          }
        },
        "unresolved_findings": { "$ref": "#/$defs/findings" }
      }
    }
  ],
  "$defs": {
    "slice": { "enum": ["lane_a", "lane_b", "lane_c", "lane_d", "integrator"] },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "range": { "type": "string", "pattern": "^[0-9a-f]{40}\\.\\.[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "impactRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "api", "arguments", "observed_risk", "result"],
      "properties": {
        "request_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
        "api": { "const": "mcp__gitnexus__impact" },
        "arguments": {
          "type": "object", "additionalProperties": false,
          "required": ["repo", "target", "direction", "maxDepth", "minConfidence", "includeTests"],
          "properties": {
            "repo": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "direction": { "const": "upstream" },
            "maxDepth": { "type": "integer", "minimum": 1, "maximum": 32 },
            "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "includeTests": { "type": "boolean" },
            "file_path": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "limit": { "type": "integer", "minimum": 1 },
            "offset": { "type": "integer", "minimum": 0 },
            "summaryOnly": { "type": "boolean" },
            "timeoutMs": { "type": "integer", "minimum": 1 }
          }
        },
        "observed_risk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"] },
        "result": { "$ref": "#/$defs/artifact" }
      }
    },
    "detectRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "arguments", "result"],
      "properties": {
        "api": { "const": "mcp__gitnexus__detect_changes" },
        "arguments": {
          "type": "object", "additionalProperties": false,
          "required": ["repo", "worktree", "scope", "base_ref"],
          "properties": {
            "repo": { "type": "string", "minLength": 1 },
            "worktree": { "type": "string", "minLength": 1 },
            "scope": { "const": "compare" },
            "base_ref": { "$ref": "#/$defs/commit" },
            "branch": { "type": "string", "minLength": 1 }
          }
        },
        "result": { "$ref": "#/$defs/artifact" }
      }
    },
    "graphifyRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "exit_code", "result"],
      "properties": {
        "argv": {
          "type": "array", "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "exit_code": { "const": 0 },
        "result": { "$ref": "#/$defs/artifact" }
      }
    },
    "findings": {
      "type": "object", "additionalProperties": false,
      "required": ["p0", "p1", "p2"],
      "properties": { "p0": { "const": 0 }, "p1": { "const": 0 }, "p2": { "const": 0 } }
    }
  }
}
