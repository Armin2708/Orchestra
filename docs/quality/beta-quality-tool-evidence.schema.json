{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tool", "lane", "tested_commit", "impact", "detect_changes", "unresolved_findings"],
      "properties": {
        "schema_version": { "const": 1 },
        "tool": { "const": "gitnexus" },
        "lane": { "enum": ["lane_a", "lane_b", "lane_c", "lane_d", "integrator"] },
        "tested_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "impact": { "type": "object", "additionalProperties": false, "required": ["risk", "targets", "affected_symbols", "affected_processes", "affected_modules"], "properties": { "risk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] }, "targets": { "type": "integer", "minimum": 1 }, "affected_symbols": { "type": "integer", "minimum": 0 }, "affected_processes": { "type": "integer", "minimum": 0 }, "affected_modules": { "type": "integer", "minimum": 0 } } },
        "detect_changes": { "type": "object", "additionalProperties": false, "required": ["risk", "changed_files", "changed_symbols", "affected_processes"], "properties": { "risk": { "enum": ["low", "medium", "high", "critical"] }, "changed_files": { "type": "integer", "minimum": 1 }, "changed_symbols": { "type": "integer", "minimum": 0 }, "affected_processes": { "type": "integer", "minimum": 0 } } },
        "unresolved_findings": { "$ref": "#/$defs/findings" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tool", "lane", "tested_commit", "operation", "source_commit", "graph_sha256", "manifest_sha256", "updated_sources", "unresolved_findings"],
      "properties": {
        "schema_version": { "const": 1 },
        "tool": { "const": "graphify" },
        "lane": { "enum": ["lane_a", "lane_b", "lane_c", "lane_d", "integrator"] },
        "tested_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "operation": { "const": "update" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "graph_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "updated_sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "unresolved_findings": { "$ref": "#/$defs/findings" }
      }
    }
  ],
  "$defs": { "findings": { "type": "object", "additionalProperties": false, "required": ["p0", "p1", "p2"], "properties": { "p0": { "const": 0 }, "p1": { "const": 0 }, "p2": { "const": 0 } } } }
}
