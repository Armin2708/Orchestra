{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tool", "lane", "tested_commit", "base_ref", "range", "ready_marker", "tool_version", "invocation_argv", "raw_impact", "raw_detect_changes", "unresolved_findings"],
      "properties": {
        "schema_version": { "const": 2 },
        "tool": { "const": "gitnexus" },
        "lane": { "$ref": "#/$defs/lane" },
        "tested_commit": { "$ref": "#/$defs/commit" },
        "base_ref": { "$ref": "#/$defs/commit" },
        "range": { "type": "string", "minLength": 82 },
        "ready_marker": { "type": "string", "minLength": 1 },
        "tool_version": { "type": "string", "minLength": 1 },
        "invocation_argv": { "type": "object", "additionalProperties": false, "required": ["impact", "detect_changes"], "properties": { "impact": { "$ref": "#/$defs/argv" }, "detect_changes": { "$ref": "#/$defs/argv" } } },
        "raw_impact": { "$ref": "#/$defs/artifact" },
        "raw_detect_changes": { "$ref": "#/$defs/artifact" },
        "unresolved_findings": { "$ref": "#/$defs/findings" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tool", "lane", "tested_commit", "base_ref", "range", "ready_marker", "tool_version", "invocation_argv", "raw_update", "raw_status", "graph_artifact", "manifest_artifact", "unresolved_findings"],
      "properties": {
        "schema_version": { "const": 2 },
        "tool": { "const": "graphify" },
        "lane": { "$ref": "#/$defs/lane" },
        "tested_commit": { "$ref": "#/$defs/commit" },
        "base_ref": { "$ref": "#/$defs/commit" },
        "range": { "type": "string", "minLength": 82 },
        "ready_marker": { "type": "string", "minLength": 1 },
        "tool_version": { "type": "string", "minLength": 1 },
        "invocation_argv": { "type": "object", "additionalProperties": false, "required": ["update", "status"], "properties": { "update": { "$ref": "#/$defs/argv" }, "status": { "$ref": "#/$defs/argv" } } },
        "raw_update": { "$ref": "#/$defs/artifact" },
        "raw_status": { "$ref": "#/$defs/artifact" },
        "graph_artifact": { "$ref": "#/$defs/artifact" },
        "manifest_artifact": { "$ref": "#/$defs/artifact" },
        "unresolved_findings": { "$ref": "#/$defs/findings" }
      }
    }
  ],
  "$defs": {
    "lane": { "enum": ["lane_a", "lane_b", "lane_c", "lane_d", "integrator"] },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "argv": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "output_sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "findings": { "type": "object", "additionalProperties": false, "required": ["p0", "p1", "p2"], "properties": { "p0": { "const": 0 }, "p1": { "const": 0 }, "p2": { "const": 0 } } }
  }
}
