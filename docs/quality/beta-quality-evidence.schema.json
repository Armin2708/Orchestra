{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tested_commit", "requirements_sha256", "schema_sha256", "artifacts", "commands", "case_results", "tool_reports"],
  "properties": {
    "schema_version": { "const": 1 },
    "tested_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "requirements_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } },
    "commands": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "argv", "exit_code", "log_path", "log_sha256", "test_files", "tests", "failed"], "properties": { "id": { "type": "string", "minLength": 1 }, "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "exit_code": { "const": 0 }, "log_path": { "type": "string", "minLength": 1 }, "log_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "test_files": { "type": "integer", "minimum": 1 }, "tests": { "type": "integer", "minimum": 1 }, "failed": { "const": 0 } } } },
    "case_results": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["item", "case", "command_ids", "status"], "properties": { "item": { "type": "string", "minLength": 1 }, "case": { "type": "string", "minLength": 1 }, "command_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "status": { "const": "passed" } } } },
    "tool_reports": { "type": "object", "additionalProperties": false, "required": ["gitnexus", "graphify"], "properties": { "gitnexus": { "$ref": "#/$defs/toolReport" }, "graphify": { "$ref": "#/$defs/toolReport" } } }
  },
  "$defs": { "toolReport": { "type": "object", "additionalProperties": false, "required": ["tested_commit", "path", "sha256"], "properties": { "tested_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } }
}
