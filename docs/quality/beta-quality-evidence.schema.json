{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tested_commit", "requirements_sha256", "schema_sha256",
    "tool_schema_sha256", "integration_schema_sha256", "signature_schema_sha256",
    "qa018_closure_supported", "integration_manifest", "qa018_signature_receipt",
    "artifacts", "commands", "case_results"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "tested_commit": { "$ref": "#/$defs/commit" },
    "requirements_sha256": { "$ref": "#/$defs/sha256" },
    "schema_sha256": { "$ref": "#/$defs/sha256" },
    "tool_schema_sha256": { "$ref": "#/$defs/sha256" },
    "integration_schema_sha256": { "$ref": "#/$defs/sha256" },
    "signature_schema_sha256": { "$ref": "#/$defs/sha256" },
    "qa018_closure_supported": { "type": "boolean" },
    "integration_manifest": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }]
    },
    "qa018_signature_receipt": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }]
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "commands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "id", "argv", "exit_code", "log_path", "log_sha256", "test_files", "tests",
          "passed", "failed", "pending", "skipped", "todo"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "argv": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "exit_code": { "const": 0 },
          "log_path": { "type": "string", "minLength": 1 },
          "log_sha256": { "$ref": "#/$defs/sha256" },
          "test_files": { "type": "integer", "minimum": 1 },
          "tests": { "type": "integer", "minimum": 1 },
          "passed": { "type": "integer", "minimum": 1 },
          "failed": { "const": 0 },
          "pending": { "const": 0 },
          "skipped": { "const": 0 },
          "todo": { "const": 0 }
        }
      }
    },
    "case_results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item", "case", "command_ids", "status"],
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "case": { "type": "string", "minLength": 1 },
          "command_ids": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "status": { "const": "passed" }
        }
      }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
