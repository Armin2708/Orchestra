{
  "description": "Orchestra board registration, presence, delivery, and subagent hooks for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@0.1.1 hook session-start --provider codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@0.1.1 hook post-tool-use --provider codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@0.1.1 hook user-prompt-submit --provider codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@0.1.1 hook stop --provider codex"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@0.1.1 hook permission-request --provider codex"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@0.1.1 hook subagent-start --provider codex"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@0.1.1 hook subagent-stop --provider codex"
          }
        ]
      }
    ]
  }
}
