{
  "description": "Orchestra board registration, presence, delivery, and subagent hooks for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@latest hook session-start --provider codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@latest hook post-tool-use --provider codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@latest hook user-prompt-submit --provider codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@latest hook stop --provider codex"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@latest hook permission-request --provider codex"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@latest hook subagent-start --provider codex"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y orchestra-board@latest hook subagent-stop --provider codex"
          }
        ]
      }
    ]
  }
}
